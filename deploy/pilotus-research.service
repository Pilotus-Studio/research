[Unit]
Description=Pilotus Research static website
After=network-online.target

[Service]
ExecStart=/usr/bin/caddy run --config /home/cheng/docker-projects/research/deploy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=96M
TasksMax=64

[Install]
WantedBy=default.target
